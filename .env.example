# ==============================================================================
# Blox Fruit Services — Essential Environment Variables
# ==============================================================================
# Note: Real secrets must never be committed to GitHub or hardcoded into source code.
# Configure these in your Vercel Project Settings or local .env file.

# 1. Staff Admin Master Password (or bcrypt hash starting with $2b$)
ADMIN_PASSWORD=placeholder_set_a_strong_staff_password_here

# 2. Neon PostgreSQL Connection String (retrieve from https://neon.tech)
# Example: postgresql://[user]:[password]@[ep-xyz].us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:placeholder_password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require

# 3. Staff Session Secret Key (used for signing HMAC-SHA256 session cookies)
# Generate a random 64-character alphanumeric string
SESSION_SECRET=placeholder_generate_random_64_character_hex_session_key

# 4. Hosting Runtime Environment
NODE_ENV=production

# 5. Optional Port (defaults to 3000 if omitted)
# PORT=3000

# 6. Optional Discord Community / Proof Invite Link (defaults to placeholder if omitted)
# VITE_DISCORD_INVITE_URL=https://discord.gg/your-actual-community-link

# 7. Gemini API Key (Server-side only — used for Google Search Grounding to research live Blox Fruits trading values)
# Can be configured in Google AI Studio Settings > Secrets or local environment.
# GEMINI_API_KEY=your_gemini_api_key_here